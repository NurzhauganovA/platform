# Настройки платформы. Скопируйте в .env и заполните — .env в git не попадает.
#
# Префикс PLATFORM__ отличается от TENDER__ намеренно: платформа и подключённые
# к ней проекты настраиваются раздельно, каждый своим файлом.

# --- Окружение ---
# dev | prod
PLATFORM__ENVIRONMENT=dev
PLATFORM__LOG_LEVEL=INFO
# console | json — в бою удобнее json
PLATFORM__LOG_FORMAT=console

# --- База ---
PLATFORM__DB__URL=postgresql+psycopg://fintend:fintend@localhost:5432/fintend

# --- Очередь ---
PLATFORM__REDIS__URL=redis://localhost:6379/0

# --- Вход ---
# Ключ подписи сессий. В разработке можно оставить пустым — тогда он
# генерируется на запуск и все сессии слетают при перезапуске.
# В бою обязателен: python -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM__AUTH__SECRET_KEY=
# В бою обязательно true, иначе кука уходит по открытому HTTP.
PLATFORM__AUTH__SECURE_COOKIES=false
# PLATFORM__AUTH__SESSION_TTL_HOURS=12

# --- Хранилище загруженных файлов ---
# Раскладка по sha256: один и тот же файл в трёх закупках хранится один раз.
# PLATFORM__STORAGE__ROOT=storage
# PLATFORM__STORAGE__MAX_UPLOAD_MB=64

# --- Фронтенд ---
# Откуда пускаем браузер. По умолчанию — дев-сервер Vite.
# PLATFORM__CORS_ORIGINS=["http://localhost:5173"]

# --- Ключи моделей ---
# Читают SDK подключённых проектов, поэтому имена без префикса платформы.
# Нужен ключ того провайдера, который выбран в настройках тендерного ядра.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
